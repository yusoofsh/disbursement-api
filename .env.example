NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disbursement

JWT_ACCESS_SECRET=replace-with-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Rate limiting (requests per minute, keyed by user id; IP for public routes)
RATE_LIMIT_MAX=120
RATE_LIMIT_CREATE_MAX=30
RATE_LIMIT_LOGIN_MAX=10

# Comma-separated allowed browser origins for the interactive demo page.
# Empty = CORS disabled (same-origin only). "*" = allow any origin (dev only).
CORS_ORIGIN=

# Public base URL advertised in the OpenAPI docs (e.g. https://disbursement.yusoofsh.cloud).
# Empty = omit the `servers` field; Swagger UI then uses the page origin.
PUBLIC_URL=

LOG_LEVEL=info
